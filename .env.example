# ── Admin dashboard ──────────────────────────────────────────────────
# Password the client types at /admin/login. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Secret used to sign the login session cookie. 32+ random characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-32-plus-random-characters-here

# ── Content storage ─────────────────────────────────────────────────
# Absolute path to a folder OUTSIDE this app where edited content and
# uploaded images are kept, so a redeploy never wipes the client's work.
# On Hostinger:  /home/uXXXXXXXX/mardesign-data
# Leave unset for local development (defaults to ./data).
# CONTENT_DIR=/absolute/path/to/mardesign-data

# ── SEO ─────────────────────────────────────────────────────────────
# The live site origin, no trailing slash. Overrides the value in
# site.json. Set this in production so canonical URLs, the sitemap and
# structured data all point at the real domain.
NEXT_PUBLIC_SITE_URL=https://mardesign-ks.com

# Google Search Console verification token (the content="" value of the
# meta tag Search Console gives you). Optional.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXX). Optional — analytics
# only loads when this is set.
# NEXT_PUBLIC_GA_ID=
